# Copy this file to .env and fill in real values locally.
# Never commit .env — it is gitignored.

# Flask
SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP (use a Google Account *app password*, not your login password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail@example.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER_NAME=Baby Milestone Journal
# Optional; defaults to MAIL_USERNAME
# MAIL_DEFAULT_SENDER=your-gmail@example.com
